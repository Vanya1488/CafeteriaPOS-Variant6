digraph UML_COMPONENT {
	bgcolor=white fontcolor="#172b4d" fontname="DejaVu Sans" fontsize=19 label="UML — Диаграмма компонентов CafeteriaPOS" labelloc=t nodesep=.6 pad=.32 rankdir=LR ranksep=.9 splines=polyline
	node [color="#395273" fillcolor="#f1f5fa" fontcolor="#182c4a" fontname="DejaVu Sans" fontsize=11 margin=".22,.15" penwidth=1.35 style=filled]
	edge [arrowsize=.7 color="#46617e" fontcolor="#344e68" fontname="DejaVu Sans" fontsize=10]
	splines=ortho
	actor [label="«external»
Клиент API" fillcolor="#eef2ff" shape=box]
	subgraph cluster_runtime {
		bgcolor="#fafcff" color="#506f92" fontname="DejaVu Sans" fontsize=13 label="«subsystem» CafeteriaPOS / .NET 8" style=rounded
		endpoint [label="«component»
REST API / Program.cs" fillcolor="#d9ecfb" shape=component]
		service [label="«component»
OrderService" fillcolor="#d9f1e6" shape=component]
		store [label="«component»
In-memory lists
(menu, orders)" fillcolor="#e9edf1" shape=component]
		http_port [label="HTTP/JSON" fillcolor=white fixedsize=true fontsize=8 height=.8 shape=circle width=.8]
		orders_port [label="IOrderOperations
(концептуальный контракт)" fillcolor=white fontsize=9 shape=ellipse]
		http_port -> endpoint [arrowhead=none]
		endpoint -> orders_port [label="использует" arrowhead=none]
		orders_port -> service [arrowhead=none]
		service -> store [label="доступ к данным"]
	}
	actor -> http_port [label="запросы"]
	label="UML — Диаграмма компонентов CafeteriaPOS
Примечание: IOrderOperations — обозначение интерфейса на схеме,
не отдельный C# interface в текущем исходном коде."
}
